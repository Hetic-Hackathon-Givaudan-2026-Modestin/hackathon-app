# Copié en api/.env à la création du conteneur. Le .env n'est jamais commité.
DATABASE_URL=postgres://app:app@db:5432/app

# API de scoring démarrée sur la machine hôte, accessible depuis le Dev Container.
# Contrat provisoire : POST /score -> { "score": 0-100 }.
SCORING_BASE_URL=http://host.docker.internal:8000
# À renseigner si le service de scoring exige une clé Bearer.
# SCORING_API_KEY=
