{
  "name": "hackathon",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w api\" \"npm run dev -w web\"",
    "build": "npm run build --workspaces",
    "test": "node --test api/test/integration.test.js web/test/project.test.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
